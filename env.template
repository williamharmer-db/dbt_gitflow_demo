# Databricks Connection Credentials
# Copy this file to .env and fill in your actual values
# Then run: source .env

# Your Databricks workspace hostname (without https://)
# Example: adb-1234567890123456.7.azuredatabricks.net
export DATABRICKS_HOST="your-workspace.azuredatabricks.net"

# Your SQL Warehouse HTTP Path
# Example: /sql/1.0/warehouses/abc123def456
export DATABRICKS_HTTP_PATH="/sql/1.0/warehouses/your-warehouse-id"

# Your Personal Access Token
# Generate this in Databricks: Settings -> User Settings -> Access Tokens
export DATABRICKS_TOKEN="your-token-here"

# Your development schema (use your name to avoid conflicts)
# Example: dbt_william or dbt_alice
export DBT_DEV_SCHEMA="dbt_william"

